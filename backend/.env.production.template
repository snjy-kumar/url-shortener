# Production Environment Variables Template
# Copy this file and fill in the values for your Northflank deployment

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Get this from Northflank PostgreSQL addon or Prisma Accelerate
DATABASE_URL=postgresql://username:password@host:port/database

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# JWT CONFIGURATION
# ============================================
# IMPORTANT: Generate strong random secrets for production!
# Use: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# URL CONFIGURATION
# ============================================
# Update this with your actual Northflank URL after deployment
BASE_URL=https://site--url-shortener--44yr75b2v68c.code.run
SHORT_CODE_LENGTH=7

# ============================================
# CORS CONFIGURATION
# ============================================
# Add your frontend URL here (comma-separated for multiple origins)
CORS_ORIGIN=https://your-frontend-url.code.run

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# ============================================
# REDIS CONFIGURATION
# ============================================
# Get this from Northflank Redis addon
REDIS_URL=redis://username:password@host:port

# ============================================
# SECURITY
# ============================================
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=900000

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
EMAIL_VERIFICATION_EXPIRES=86400000
PASSWORD_RESET_EXPIRES=3600000

# ============================================
# OPTIONAL: Email Service Configuration
# ============================================
# If you're using email functionality, add your SMTP settings:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@yourdomain.com
