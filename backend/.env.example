# Environment
NODE_ENV=development

# Server
PORT=3000
BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
TRUST_PROXY=false

# Database (PostgreSQL required)
DATABASE_URL="postgresql://username:password@localhost:5432/url_shortener?schema=public"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Per authenticated user (Clerk userId) on /api/v1/urls
AUTH_RATE_LIMIT_MAX_REQUESTS=60
# Anonymous POST /shorten (IP-keyed; skipped when signed in)
GUEST_CREATE_RATE_LIMIT_MAX_REQUESTS=20

# URLs
SHORT_CODE_LENGTH=7

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# Clerk (same keys as frontend .env.local)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# From Clerk Dashboard → Webhooks → endpoint signing secret
# Endpoint URL: https://<host>/api/v1/webhooks/clerk  (subscribe to user.deleted)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Comma-separated Clerk user IDs allowed to use /api/v1/admin/*
ADMIN_CLERK_USER_IDS=user_...

# Optional Redis for redirect cache (falls back to in-memory LRU)
# REDIS_URL=redis://127.0.0.1:6379
REDIRECT_CACHE_TTL_SECONDS=300

# Cloudflare Turnstile (guest create). Leave unset to skip in development.
# TURNSTILE_SECRET_KEY=0x...
# TURNSTILE_REQUIRED_IN_PROD=true

# Google Safe Browsing API key (optional malware/phishing check on create)
# SAFE_BROWSING_API_KEY=...
# SAFE_BROWSING_FAIL_CLOSED=false

