#!/usr/bin/env sh

echo "🔍 Running pre-push checks..."

# 1. Type check
echo "📝 Type checking..."
npm run type-check || {
  echo "❌ Type check failed!"
  exit 1
}

# 2. Build check
echo "🔨 Building..."
npm run build || {
  echo "❌ Build failed!"
  exit 1
}

# 3. Lint check
echo "🧹 Linting..."
npm run lint || {
  echo "❌ Lint check failed!"
  exit 1
}

# 4. Security audit
echo "🔒 Security audit..."
npm audit --audit-level=high || {
  echo "❌ Security vulnerabilities found!"
  exit 1
}

# 5. Check for production deployment
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ] || [ "$BRANCH" = "production" ]; then
  echo "⚠️  WARNING: Pushing to $BRANCH branch!"
  echo "This will trigger production deployment."
  echo "Are you sure? Type 'yes' to continue:"
  read -r CONFIRM
  if [ "$CONFIRM" != "yes" ]; then
    echo "❌ Push cancelled"
    exit 1
  fi
fi

echo "✅ All pre-push checks passed!"
echo "✨ Ready to push"
