{
  "name": "url-shortener-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "A scalable URL shortener service built with Node.js, TypeScript, Prisma, and PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "husky || true",
    "clean": "rm -rf dist .tsbuildinfo",
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "node -e \"const fs = require('fs'); if (!fs.existsSync('dist')) { console.error('❌ Build failed: dist/ not created'); process.exit(1); } const path = require('path'); const countFiles = (dir) => { let count = 0; const items = fs.readdirSync(dir); items.forEach(item => { const fullPath = path.join(dir, item); if (fs.statSync(fullPath).isDirectory()) count += countFiles(fullPath); else if (item.endsWith('.js')) count++; }); return count; }; console.log('✅ Build completed: ' + countFiles('dist') + ' JS files');\"",
    "start": "NODE_ENV=production node dist/index.js",
    "start:prod": "NODE_ENV=production node --max-old-space-size=512 dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:debug": "tsx watch --inspect src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "type-check": "tsc --noEmit",
    "type-check:file": "node scripts/typecheck-file.js",
    "prepare": "husky"
  },
  "keywords": [
    "url-shortener",
    "nodejs",
    "typescript",
    "prisma",
    "postgresql",
    "express",
    "api"
  ],
  "author": "Sanjay Kumar Thakur",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@sentry/node": "^7.120.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.12",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "speakeasy": "^2.0.0",
    "uuid": "^13.0.0",
    "valid-url": "^1.0.9",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.19.5",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/redis": "^4.0.11",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/valid-url": "^1.0.7",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "prisma": "^7.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=8.0.0"
  }
}
